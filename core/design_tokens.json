{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "token_set": "flashcard.visual.v2",
  "version": "2.4.0",
  "canvas_reference": {
    "width": 1536,
    "height": 2048,
    "orientation": "portrait"
  },
  "label_card": {
    "fill": "#FFFFFF",
    "fill_opacity": 0.98,
    "corner_radius_ratio": 0.018,
    "shadow": "subtle",
    "border": "none_or_hairline",
    "padding_ratio_x": 0.024,
    "padding_ratio_y": 0.016
  },
  "typography": {
    "target_term": {
      "role": "dominant",
      "color": "#0E2B6D",
      "weight": "bold",
      "preferred_size_px_at_1536w": [60, 76],
      "hard_min_px_at_1536w": 54,
      "font_requirement": "full glyph coverage for the active target-language profile"
    },
    "pronunciation": {
      "role": "secondary_optional",
      "color": "#56677F",
      "preferred_size_px_at_1536w": [32, 42],
      "hard_min_px_at_1536w": 28,
      "font_requirement": "full glyph coverage for the declared pronunciation system"
    },
    "gloss": {
      "role": "secondary",
      "color": "#333333",
      "preferred_size_px_at_1536w": [32, 42],
      "hard_min_px_at_1536w": 28,
      "font_requirement": "full glyph coverage for the declared gloss language"
    },
    "english": {
      "role": "legacy_alias_for_target_term",
      "color": "#0E2B6D",
      "weight": "bold",
      "preferred_size_px_at_1536w": [60, 76],
      "hard_min_px_at_1536w": 54
    },
    "ipa": {
      "role": "legacy_alias_for_pronunciation",
      "color": "#56677F",
      "preferred_size_px_at_1536w": [32, 42],
      "hard_min_px_at_1536w": 28
    },
    "chinese": {
      "role": "legacy_alias_for_chinese_gloss",
      "color": "#333333",
      "preferred_size_px_at_1536w": [32, 42],
      "hard_min_px_at_1536w": 28
    },
    "font_selection": "language-profile-and-adapter-resolved",
    "render_normalization": "NFC; source strings remain unchanged"
  },
  "connector": {
    "token": "connector.v3.light",
    "line_color": "#B7C6D8",
    "line_opacity": 0.78,
    "line_width_px_at_1536w": [
      2,
      3
    ],
    "endpoint_dot_diameter_px_at_1536w": [
      6,
      8
    ],
    "endpoint_dot_color": "#A1B4CA",
    "start_dot": false,
    "shadow": false,
    "glow": false,
    "forbidden_anchor_colors": [
      "red",
      "orange",
      "yellow"
    ]
  }
}
